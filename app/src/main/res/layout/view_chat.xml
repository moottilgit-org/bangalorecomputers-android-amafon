<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llCompose"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPrimaryLight"
    android:orientation="vertical" >

    <android.support.v7.widget.CardView
        android:id="@+id/cvMessageRef"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        app:cardElevation="3dp"
        app:cardCornerRadius="2dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMessageRef"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:padding="4dp"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/colorPrimaryDark"
                tools:text="item" />

            <ImageButton
                android:id="@+id/imgMessageRef"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:layout_margin="3dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bordered_rectangle_rounded_corners"
                app:srcCompat="@drawable/ic_clear_black"/>

        </LinearLayout>

    </android.support.v7.widget.CardView>

    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" >

        <ImageButton
            android:id="@+id/imgAudioRecord"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/voicerecorder_image_mic"
            style="@style/AppTheme.AppButton.Inverse"/>

        <ImageButton
            android:id="@+id/imgImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@+id/imgAudioRecord"
            android:layout_marginStart="4dp"
            android:padding="4dp"
            android:visibility="gone"
            tools:visibility="visible"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_gallery"
            style="@style/AppTheme.AppButton.Inverse" />

        <EditText
            android:id="@+id/edCompose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="3dp"
            android:layout_toStartOf="@+id/btnSendMessage"
            android:layout_toEndOf="@+id/imgImage"
            android:background="@android:drawable/editbox_background"
            android:gravity="top"
            android:hint="Type your message here..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:minHeight="40dp"
            android:minLines="1" />

        <LinearLayout
            android:id="@+id/llRecording"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_toStartOf="@+id/imgRecDelete"
            android:layout_toEndOf="@+id/imgRecPlay"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">
            <TextView
                android:id="@+id/tvRecording"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recording..."
                android:textColor="@color/colorAccent"
                android:layout_gravity="center_vertical"/>
            <Chronometer
                android:id="@+id/cmRecording"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/colorAccent"
                android:layout_gravity="center_vertical"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSendMessage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/edCompose"
            android:padding="4dp"
            android:layout_marginStart="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/btn_send_fg"
            android:background="@drawable/btn_send" />

        <TextView
            android:id="@+id/tvTextInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/btnSendMessage"
            android:layout_alignStart="@+id/btnSendMessage"
            tools:text="0/0"
            android:visibility="invisible"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/imgRecPlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@+id/imgAudioRecord"
            android:scaleType="fitCenter"
            android:src="@drawable/img_play"
            style="@style/AppTheme.AppButton.Inverse"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/imgRecDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/btnSendMessage"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_delete_black"
            style="@style/AppTheme.AppButton.Inverse"
            android:visibility="gone"
            tools:visibility="visible" />
    </RelativeLayout>
</LinearLayout>