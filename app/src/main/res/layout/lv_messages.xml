<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:descendantFocusability="blocksDescendants"
    android:padding="0dp" >

    <TextView
        android:id="@+id/tvDateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:gravity="bottom|center"
        android:maxLines="1"
        android:text="13/07/2017"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <LinearLayout
        android:id="@+id/llMsgContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="50dp"
        android:paddingStart="50dp"
        android:layout_below="@+id/tvDateTitle"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/message_bubble_sent"
            android:orientation="vertical"
            android:layout_gravity="right"
            android:minWidth="100dp"
            android:padding="0dp"
            android:weightSum="1">

            <android.support.v7.widget.CardView
                android:id="@+id/cvMessageRef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="3dp"
                app:cardCornerRadius="2dp"
                android:visibility="gone"
                tools:visibility="visible">
                <TextView
                    android:id="@+id/tvMessageRef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="3dp"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/colorPrimaryDark"
                    tools:text="item" />
            </android.support.v7.widget.CardView>

            <TextView
                android:id="@+id/tvMessageFrom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="10dp"
                android:text="Name"
                android:textColor="@color/dark_blue"
                android:textSize="14sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="10dp"
                android:text="Hello"
                android:linksClickable="true"
                android:textSize="14sp"
                android:autoLink="all"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="0.33">
                <TextView
                    android:id="@+id/tvTime1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginLeft="10dp"
                    android:layout_marginBottom="2dp"
                    android:drawableStart="@drawable/receipt_read"
                    android:gravity="bottom|start"
                    android:maxLines="1"
                    android:text="1:33 pm"
                    android:textSize="12sp"
                    android:visibility="gone"/>

                <View
                    android:id="@+id/vwSpacer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvTime2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="2dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:drawableEnd="@drawable/receipt_read"
                    android:gravity="bottom|start"
                    android:maxLines="1"
                    android:text="1:33 pm"
                    android:textSize="12sp"
                    android:visibility="visible"/>
                <TextView
                    android:id="@+id/tvChatWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="2dp"
                    android:layout_marginEnd="10dp"
                    android:drawableEnd="@drawable/receipt_warning"
                    android:gravity="bottom|start"
                    android:maxLines="1"
                    android:text="1"
                    android:textSize="12sp"
                    android:visibility="visible"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>