<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp"
    android:layout_margin="3dp"
    android:background="?selectableItemBackground" >

    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="6dp"
        app:cardCornerRadius="4dp" >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:src="@drawable/wmv"/>

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/imgAvatar"
                android:layout_alignParentTop="true"
                android:textSize="18sp"
                android:textColor="@color/colorPrimaryDark"
                tools:text="Muhammed Anees C.A" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/imgAvatar"
                android:layout_below="@+id/tvName"
                android:layout_toStartOf="@+id/tvNumber"
                android:drawableStart="@drawable/ic_access_time_icon"
                android:textSize="12sp"
                android:textColor="@color/colorPrimaryDark"
                tools:text="1234567890" />

            <TextView
                android:id="@+id/tvNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_below="@+id/tvName"
                android:gravity="top|end"
                android:drawableStart="@drawable/ic_call_icon"
                android:textSize="12sp"
                android:textColor="@color/colorPrimaryDark"
                tools:text="1234567890" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/imgAvatar"
                android:layout_below="@+id/tvDate"
                android:gravity="top|end"
                android:textSize="14sp"
                android:textColor="@color/colorAccent"
                tools:text="NEW" />

            <Button
                android:id="@+id/btnCall"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false"
                android:layout_below="@+id/tvStatus"
                android:layout_toEndOf="@+id/imgAvatar"
                android:drawableStart="@drawable/ic_call_white"
                style="@style/AppTheme.AppButton2"
                android:text="@string/call"/>

            <Button
                android:id="@+id/btnView"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:textAllCaps="false"
                android:layout_below="@+id/tvStatus"
                android:layout_toEndOf="@+id/btnCall"
                android:drawableStart="@drawable/ic_open_in_new_white"
                style="@style/AppTheme.AppButton2"
                android:text="@string/view"/>

            <RelativeLayout
                android:id="@+id/rlMessageCount"
                android:layout_width="42dp"
                android:layout_height="32dp"
                android:layout_below="@+id/tvStatus"
                android:layout_toEndOf="@+id/btnView"
                style="@style/AppTheme.AppButton2"
                android:visibility="gone"
                tools:visibility="visible">
                <ImageView
                    android:id="@+id/imgMsgIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="3dp"
                    app:srcCompat="@drawable/ic_email_icon_white"/>
                <TextView
                    android:id="@+id/tvMessageCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:padding="6dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    tools:text="9+"
                    android:background="@drawable/badge_circle"/>
            </RelativeLayout>

            <TextView
                android:id="@+id/tvOrderID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_below="@+id/tvStatus"
                android:gravity="end"
                android:textSize="24sp"
                android:textColor="@color/colorAccent"
                android:textStyle="bold"
                tools:text="#123" />

        </RelativeLayout>
    </android.support.v7.widget.CardView>

</FrameLayout>